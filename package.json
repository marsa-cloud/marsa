{
  "name": "marsa",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source, self-hostable Platform as a Service (PaaS)",
  "license": "AGPL-3.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "@nuxt/devtools@<3.4.3": "^3.4.3",
      "@xhmikosr/decompress@<11.1.4": "^11.1.4",
      "baseline-browser-mapping@<2.11.0": "^2.11.0",
      "brace-expansion@<1.1.21": "^1.1.21",
      "brace-expansion@>=2.0.0 <2.1.7": "^2.1.7",
      "brace-expansion@>=4.0.0 <5.0.12": "^5.0.12",
      "browserslist@<4.28.7": "^4.28.7",
      "devalue@<5.9.3": "^5.9.3",
      "diff@<8.0.3": "^8.0.3",
      "esbuild@<0.28.1": "^0.28.1",
      "fast-uri@<3.1.8": "^3.1.8",
      "fast-uri@>=4.0.0 <4.1.5": "^4.1.5",
      "fastify@<5.12.5": "^5.12.5",
      "find-my-way@<9.7.0": "^9.7.0",
      "ip-address@<10.7.1": "^10.7.1",
      "joi@<17.13.8": "^17.13.8",
      "js-yaml@<4.3.2": "^4.3.2",
      "launch-editor@<2.14.2": "^2.14.2",
      "multer@<2.4.0": "^2.4.0",
      "piscina@<4.9.4": "^4.9.4",
      "postcss-selector-parser@<7.1.6": "^7.1.6",
      "prosemirror-view@<1.42.3": "^1.42.3",
      "proxy-addr@<2.0.8": "^2.0.8",
      "qs@<6.16.0": "^6.16.0",
      "seroval@<1.6.3": "^1.6.3",
      "shell-quote@<1.11.0": "^1.11.0",
      "source-map-js@<1.2.2": "^1.2.2",
      "svgo@>=4.0.0 <4.1.0": "^4.1.0",
      "tar@<7.5.19": "^7.5.19",
      "undici@>=8.0.0 <8.10.2": "^8.10.2",
      "vite@>=8.2.0 <8.2.4": "^8.2.4",
      "vue": "^3.5.42"
    }
  },
  "scripts": {
    "clean": "pnpm -r --parallel run clean",
    "lint": "pnpm -r --parallel run lint",
    "lint:root": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "pnpm --parallel --filter api --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "seed": "node --env-file=apps/api/.env apps/api/dist/src/entrypoints/seed-dev.js",
    "build": "pnpm -r run build",
    "build:api": "pnpm --filter api build",
    "build:web": "pnpm --filter web build",
    "test": "pnpm -r --parallel run test",
    "e2e:up": "bash scripts/e2e-up.sh",
    "e2e:test": "bash scripts/e2e-test.sh",
    "e2e:down": "bash scripts/e2e-down.sh"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-simple-import-sort": "catalog:",
    "eslint-plugin-unused-imports": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
